# Frontend API base URL used by src/config/env.ts
# Keep /api in local dev so Vite proxy can forward requests to the backend.
VITE_API_BASE_URL=/api

# Vite dev proxy target for /api requests
VITE_BACKEND_PROXY_TARGET=http://localhost:4000
# Comma-separated dev hosts allowed to access Vite server (for temporary tunnels).
VITE_ALLOWED_HOSTS=localhost,127.0.0.1,::1,.loca.lt,.localtunnel.me,.ngrok-free.app,.trycloudflare.com

VITE_APP_ENV=development
VITE_ENABLE_ADMIN=true

# Production note:
# Keep VITE_API_BASE_URL=/api when using frontend/vercel.json to proxy /api
# to the VPS backend. Replace YOUR_API_DOMAIN in that file before deploying.
