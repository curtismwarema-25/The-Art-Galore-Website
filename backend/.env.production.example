# Template only. Copy values into the VPS secret store; never commit real secrets.
NODE_ENV=production
PORT=4000
TRUST_PROXY_HOPS=1
SERVE_FRONTEND=false
API_PREFIX=/api
PUBLIC_APP_URL=https://<public-app-domain>
PUBLIC_API_URL=https://<api-domain>/api
CORS_ORIGIN=https://<public-app-domain>,https://<admin-domain>
CORS_ALLOW_ALL_IN_DEV=false
DATABASE_URL=<managed-mysql-connection-string>
JWT_ACCESS_SECRET=<random-secret-at-least-32-bytes>
JWT_REFRESH_SECRET=<different-random-secret-at-least-32-bytes>
SESSION_COOKIE_NAME=agi_admin_session
SESSION_COOKIE_SECURE=true
SESSION_SAME_SITE=lax
SESSION_TTL_HOURS=168
STORAGE_PROVIDER=local
MEDIA_LOCAL_ROOT=/opt/artgalore/shared/media
BACKUP_OUTPUT_DIR=/opt/artgalore/shared/backups
BACKUP_RETENTION_DAYS=30
SEED_ADMIN_ENABLED=false
MPESA_DARAJA_ENV=sandbox
MPESA_LIVE_PAYMENTS_ENABLED=false
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=
# Check Safaricom's current official Getting Started page before deployment.
MPESA_CALLBACK_ALLOWED_IPS=196.201.214.200,196.201.214.206,196.201.213.114,196.201.214.207,196.201.214.208,196.201.213.44,196.201.212.127,196.201.212.138,196.201.212.129,196.201.212.136,196.201.212.74,196.201.212.69
EMAIL_DELIVERY_ENABLED=false
