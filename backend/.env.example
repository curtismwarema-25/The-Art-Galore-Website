# Database
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/the_art_galore_international"
# Optional explicit shadow DB URL for Prisma Migrate
SHADOW_DATABASE_URL="mysql://root:password@localhost:3306/the_art_galore_international_shadow"

# App
NODE_ENV=development
PORT=4000
TRUST_PROXY_HOPS=0
SERVE_FRONTEND=false
API_PREFIX=/api
PUBLIC_APP_URL=http://localhost:8080
# Leave blank to derive from local backend URL, or set to deployed API origin + /api.
PUBLIC_API_URL=
# Comma-separated origins allowed to send credentialed requests
CORS_ORIGIN=http://localhost:8080,http://localhost:5173,http://localhost:8083
# Dev-only temporary override for remote tunnel testing.
# When true (and NODE_ENV is not production), backend reflects any Origin.
CORS_ALLOW_ALL_IN_DEV=false

# Auth (reserved for JWT modules later)
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cookie session auth
SESSION_COOKIE_NAME=agi_admin_session
SESSION_TTL_HOURS=168
SESSION_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=

# Seed admin user (local only; disable after production admin provisioning)
SEED_ADMIN_ENABLED=true
SEED_ADMIN_EMAIL=admin@local.test
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_FULL_NAME=Local Admin
SEED_ADMIN_ROLE=ADMIN

# Storage (future)
STORAGE_PROVIDER=local
MEDIA_LOCAL_ROOT=./storage/media
MEDIA_PUBLIC_BASE_PATH=/media/files
ORDER_RESERVATION_TTL_MINUTES=15
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Backups
BACKUP_OUTPUT_DIR=
BACKUP_RETENTION_DAYS=30

# Email ticket delivery
EMAIL_DELIVERY_ENABLED=false
EMAIL_ATTACH_TICKET_PDFS=true
EMAIL_DELIVERY_RETRY_ENABLED=true
EMAIL_DELIVERY_RETRY_MAX_ATTEMPTS=5
EMAIL_DELIVERY_RETRY_SWEEP_INTERVAL_SECONDS=60
EMAIL_DELIVERY_RETRY_BATCH_SIZE=20
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Daraja / M-Pesa (future)
MPESA_DARAJA_ENV=sandbox
# Keep false during testing. Production Daraja is blocked unless this is explicitly enabled.
MPESA_LIVE_PAYMENTS_ENABLED=false
# Kenya M-Pesa business details. Keep these server-side; do not use VITE_* variables.
MPESA_SHORTCODE=174379
MPESA_ACCOUNT_NUMBER=875013
MPESA_BUSINESS_NAME=THE ART GALORE INTERNATIONAL
# Copy the passkey issued for your Daraja sandbox app.
MPESA_PASSKEY=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_CALLBACK_URL=
MPESA_CALLBACK_SECRET=
MPESA_TIMEOUT_SECONDS=30
MPESA_STK_INITIATE_COOLDOWN_SECONDS=30
MPESA_STK_PENDING_RETRY_MINUTES=5
MPESA_LATE_PAYMENT_POLICY=reject
MPESA_LATE_PAYMENT_GRACE_MINUTES=10
MPESA_RECONCILIATION_ENABLED=true
MPESA_RECONCILIATION_INTERVAL_SECONDS=30
MPESA_RECONCILIATION_MAX_ATTEMPTS=8
MPESA_RECONCILIATION_LEASE_SECONDS=120
ORDER_EXPIRY_SWEEP_INTERVAL_SECONDS=60
