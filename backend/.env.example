# Database
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/the_art_galore_international"
# Optional explicit shadow DB URL for Prisma Migrate
SHADOW_DATABASE_URL="mysql://root:password@localhost:3306/the_art_galore_international_shadow"

# App
NODE_ENV=development
PORT=4000
API_PREFIX=/api
# Comma-separated origins allowed to send credentialed requests
CORS_ORIGIN=http://localhost:8080,http://localhost:5173,http://localhost:8083
# Dev-only temporary override for remote tunnel testing.
# When true (and NODE_ENV is not production), backend reflects any Origin.
CORS_ALLOW_ALL_IN_DEV=false

# Auth (reserved for JWT modules later)
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cookie session auth
SESSION_COOKIE_NAME=agi_admin_session
SESSION_TTL_HOURS=168
SESSION_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=

# Seed admin user (local only)
SEED_ADMIN_ENABLED=true
SEED_ADMIN_EMAIL=admin@local.test
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_FULL_NAME=Local Admin
SEED_ADMIN_ROLE=ADMIN

# Storage (future)
STORAGE_PROVIDER=local
MEDIA_LOCAL_ROOT=./storage/media
MEDIA_PUBLIC_BASE_PATH=/media/files
ORDER_RESERVATION_TTL_MINUTES=15
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Daraja / M-Pesa (future)
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_CALLBACK_URL=
